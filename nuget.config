<?xml version="1.0" encoding="utf-8"?>
<!--
  Paket kaynağı depoda sabittir: tüm paketler nuget.org'dan gelir (Directory.Packages.props).
  Makinenin genel ayarlarına eklenmiş ikinci bir kaynak, merkezi paket yönetiminde NU1507'yi
  (hata sayılan uyarı) tetikleyip scripts/check'i geri yüklemede durduruyordu.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
