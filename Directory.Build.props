<Project>

  <!-- docs/conventions.md, "Enforced by tooling": bu kurallar tek yerde tanımlanır ve her yeni
       proje otomatik devralır. Araç kanundur, prose tavsiyedir. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
