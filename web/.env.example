# Panel konfigürasyonu. Gerçek değerler .env.local'a yazılır; .env.local repoya girmez (docs/security.md).

# Backend panel okuma yüzeyi (yalnızca sunucu tarafında çağrılır).
API_BASE_URL=http://localhost:5009

# Panelin dışarıdan görünen adresi; OIDC geri dönüş ve çıkış adresleri bundan türetilir.
# Tarayıcıda açtığınız adresle (host ve port) birebir aynı olmalı: localhost ≠ 127.0.0.1, 3000 ≠ 3001.
APP_URL=http://localhost:3000

# OIDC sağlayıcısı (standart OIDC; sağlayıcıdan bağımsız).
OIDC_ISSUER=http://localhost:8080/aihub
OIDC_CLIENT_ID=aihub-panel
OIDC_CLIENT_SECRET=<sağlayıcıdan alınan client secret>
# Backend'in beklediği audience'ı token'a koyduran kapsamlar.
OIDC_SCOPE=openid profile offline_access aihub-api

# Oturum çerezini şifreleyen anahtar: en az 32 karakter, rastgele. Örnek: openssl rand -base64 32
SESSION_SECRET=<en az 32 karakterlik rastgele değer>

# Yalnızca geliştirme/test: düz HTTP OIDC sağlayıcısına (mock) production derlemesinde izin verir.
# Gerçek ortamlarda tanımlanmaz.
# OIDC_ALLOW_HTTP=true
