root = true

[*]
charset = utf-8
# end_of_line bilerek yok: satır sonlarını .gitattributes (text=auto) yönetir; Windows'ta CRLF,
# CI'da LF checkout edilir ve format adımı ikisinde de aynı sonucu vermelidir.
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,slnx}]
indent_style = space
indent_size = 4

[*.{json,yml}]
indent_style = space
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all

[**/Migrations/*.cs]
generated_code = true
